{
  "project": "partner-mix",
  "entrypoints": ["src/main.tsx", "server/index.ts"],
  "files": [
    {
      "path": "shared/model.ts",
      "role": "Domain contracts and display helpers",
      "depends_on": ["shared/audience.ts", "shared/partnership.ts"]
    },
    {
      "path": "shared/validation.ts",
      "role": "Request constraints",
      "depends_on": ["shared/model.ts"]
    },
    {
      "path": "server/data.ts",
      "role": "Empty campaign creation and access capabilities",
      "depends_on": ["shared/model.ts"]
    },
    {
      "path": "server/sample.ts",
      "role": "Real-brand hypothetical brief and explicitly illustrative cost inputs",
      "depends_on": ["shared/model.ts", "shared/brand.ts"]
    },
    {
      "path": "server/store.ts",
      "role": "Private atomic file persistence and versioned writes",
      "depends_on": ["shared/model.ts"]
    },
    {
      "path": "server/qloo.ts",
      "role": "Bounded server-only Qloo adapter",
      "depends_on": [
        "shared/model.ts",
        "server/store.ts",
        "server/audience.ts",
        "server/partnership.ts"
      ]
    },
    {
      "path": "server/workflow.ts",
      "role": "Discover and compare the complete shortlist",
      "depends_on": [
        "server/qloo.ts",
        "server/solver.ts",
        "shared/audience.ts",
        "shared/partnership.ts"
      ]
    },
    {
      "path": "server/solver.ts",
      "role": "Hard constraints, ordinal portfolio heuristic and evidence-aware export",
      "depends_on": ["shared/model.ts", "shared/partnership.ts"]
    },
    {
      "path": "server/app.ts",
      "role": "Authenticated API, origin guard and optimistic concurrency",
      "depends_on": [
        "server/store.ts",
        "server/qloo.ts",
        "server/workflow.ts",
        "server/solver.ts",
        "server/sample.ts",
        "server/brand-workflow.ts",
        "server/brand-analyst.ts",
        "shared/partnership.ts"
      ]
    },
    {
      "path": "src/App.tsx",
      "role": "Campaign navigation and mutations",
      "depends_on": [
        "src/api.ts",
        "src/forms.tsx",
        "src/views.tsx",
        "src/brand.tsx",
        "src/Audience.tsx"
      ]
    },
    {
      "path": "src/forms.tsx",
      "role": "Brief, entity confirmation, roster and offers",
      "depends_on": ["shared/model.ts", "src/api.ts"]
    },
    {
      "path": "src/views.tsx",
      "role": "Package comparison, evidence matrix and decision brief",
      "depends_on": ["shared/model.ts", "src/forms.tsx", "src/Partnership.tsx"]
    },
    {
      "path": "scripts/test-qloo-live.ts",
      "role": "Opt-in bounded real API verification",
      "depends_on": ["server/qloo.ts", "server/app.ts"]
    },
    {
      "path": "shared/brand.ts",
      "role": "Brand intake, research, assessment and approval contracts",
      "depends_on": ["shared/model.ts"]
    },
    {
      "path": "server/brand-analyst.ts",
      "role": "Vertex Gemini URL-context research and structured partner assessment",
      "depends_on": ["shared/brand.ts", "server/store.ts", "shared/partnership.ts"]
    },
    {
      "path": "server/brand-workflow.ts",
      "role": "Resolve proposed references and approve a source-bound strategy",
      "depends_on": ["server/brand-analyst.ts", "server/qloo.ts", "shared/brand.ts"]
    },
    {
      "path": "src/brand.tsx",
      "role": "Website/brief intake, review, corrections, approval and partner case",
      "depends_on": ["shared/brand.ts", "src/forms.tsx"]
    },
    {
      "path": "scripts/with-slate-vertex.mjs",
      "role": "Authorized local Vertex runtime launcher; no persistent credentials",
      "depends_on": []
    },
    {
      "path": "shared/audience.ts",
      "role": "Age/gender context contracts and export formatting",
      "depends_on": []
    },
    {
      "path": "server/audience.ts",
      "role": "Strict Qloo demographic parsing and bounded batched collection",
      "depends_on": ["shared/audience.ts"]
    },
    {
      "path": "src/Audience.tsx",
      "role": "Signed demographic comparison, missing coverage and query receipts",
      "depends_on": ["shared/audience.ts", "src/Partnership.tsx"]
    },
    {
      "path": "scripts/test-audience-live.ts",
      "role": "Opt-in three-request demographic coverage and cache check",
      "depends_on": ["server/qloo.ts", "server/audience.ts"]
    },
    {
      "path": "shared/partnership.ts",
      "role": "Pair exploration contracts, contribution labels, interpretation context and exports",
      "depends_on": []
    },
    {
      "path": "server/partnership.ts",
      "role": "Bounded joint recommendations, tastes, directional associations and optional geographic cells",
      "depends_on": ["shared/partnership.ts", "server/store.ts"]
    },
    {
      "path": "src/Partnership.tsx",
      "role": "Pair exploration controls, shared interests, joint activation cards and request citations",
      "depends_on": ["shared/partnership.ts", "src/Geography.tsx"]
    },
    {
      "path": "src/Geography.tsx",
      "role": "Geohash cell geography and returned place pins without external tiles",
      "depends_on": ["shared/partnership.ts"]
    },
    {
      "path": "scripts/test-partnership-live.ts",
      "role": "Opt-in six to eight request live pair workflow",
      "depends_on": ["server/qloo.ts"]
    },
    {
      "path": "server/models.ts",
      "role": "Model chain and fallback across rate limits and invalid output",
      "depends_on": []
    }
  ]
}
